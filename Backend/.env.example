PORT=3000
MONGODB_PORT=27017
# Lokaler Node-Prozess; Compose nutzt intern den Hostnamen mongodb.
MONGODB_URI=mongodb://127.0.0.1:27017/kochfaul
# Gemini-Schlüssel aus Google AI Studio:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Erzeugen mit: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Angular-Oberfläche mit Nginx (Docker)
FRONTEND_PORT=8080

# Optionaler lokaler Foto-Erkennungsdienst: docker compose --profile vision up
INGREDIENT_RECOGNITION_PORT=8090
# Mindestens 32 Zeichen; erzeugen wie JWT_SECRET. Nur für interne Dienstaufrufe.
INGREDIENT_RECOGNITION_TOKEN=
OLLAMA_URL=http://host.docker.internal:11434
VISION_MODEL=qwen3-vl:4b-instruct

# NestJS lokal; Compose verwendet den internen Dienstnamen.
INGREDIENT_RECOGNITION_URL=http://127.0.0.1:8090
INGREDIENT_RECOGNITION_TIMEOUT_MS=190000
