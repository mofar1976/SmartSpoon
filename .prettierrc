{
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "overrides": [
    {
      "files": "Frontend/**/*.html",
      "options": {
        "parser": "angular"
      }
    }
  ],
  "plugins": ["./Frontend/node_modules/prettier-plugin-tailwindcss/dist/index.mjs"],
  "tailwindStylesheet": "./Frontend/src/tailwind.css"
}
